# Port the API listens on
PORT=3001

# Discord webhook URL — paste the webhook URL from your Discord channel settings
# Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ─── Storage backend ─────────────────────────────────────────────────────────
# Leave the three SUPABASE/BOARD vars blank to use a local board.json file.
# Set all three to make the API read/write the SAME board your team uses in the
# web app (so Discord and the browser stay in sync via realtime).
#   • SUPABASE_URL              → Supabase → Settings → API → Project URL
#   • SUPABASE_SERVICE_ROLE_KEY → Supabase → Settings → API → service_role key
#                                 (server-only secret — never expose to the browser)
#   • BOARD_ID                  → the board's UUID (from the boards table / app URL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BOARD_ID=

# ─── Security ────────────────────────────────────────────────────────────────
# If set, every /api request must send a matching `x-api-key` header.
# Use the same value in the bot's .env. Strongly recommended once hosted.
API_KEY=
